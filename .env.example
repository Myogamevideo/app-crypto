# Copy to .env. Never commit your real credentials.
APP_PASSWORD=
APP_SECRET_KEY=
COINBASE_API_KEY_NAME=organizations/your-org/apiKeys/your-key
COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nreplace-me\n-----END EC PRIVATE KEY-----\n"
# Optional CoinGecko Demo API key to increase the public fallback rate limit.
COINGECKO_API_KEY=
DATABASE_PATH=data/crypto-dashboard.sqlite3
COOKIE_SECURE=false
